# Let members of the `video` group set the panel backlight (brightness keys, idle
# dimming and penny-screen run inside the desktop session, not as root).
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
# Same for every LED: the keyboard backlight (Fn+Shift+B/N, penny-kbd-light) and the
# indicator and flash LEDs, which penny-diag switches. multi_intensity sets the colour
# of an RGB LED.
ACTION=="add", SUBSYSTEM=="leds", RUN+="/bin/sh -c 'cd /sys/class/leds/%k && for f in brightness multi_intensity; do [ -e $$f ] && chgrp video $$f && chmod g+w $$f; done; true'"
