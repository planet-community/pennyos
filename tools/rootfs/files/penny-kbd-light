#!/bin/sh
# Keyboard backlight: penny-kbd-light [cycle | off | <percent>]
#
# Fn+P runs "cycle": off -> 25 % -> 50 % -> 100 % -> off. The LED is the SoC PWM
# on GPIO90 (devicetree/pennyos-kbd-backlight.dtsi); systemd-backlight restores
# the last level at boot.
LED=$(ls -d /sys/class/leds/*kbd_backlight 2>/dev/null | head -n 1)
[ -n "$LED" ] || { echo "no keyboard backlight LED" >&2; exit 1; }
max=$(cat "$LED/max_brightness")
cur=$(cat "$LED/brightness")

case "${1:-cycle}" in
  cycle)
    # the first step above the current level; past the top, off
    new=0
    for pct in 25 50 100; do
      v=$(( max * pct / 100 ))
      [ "$v" -gt "$cur" ] && { new=$v; break; }
    done ;;
  off) new=0 ;;
  *[!0-9]*|"") echo "usage: $0 [cycle|off|<percent>]" >&2; exit 1 ;;
  *) new=$(( max * $1 / 100 )) ;;
esac
brightnessctl -q -d "${LED##*/}" set "$new"
