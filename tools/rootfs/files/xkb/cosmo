// Planet Cosmo Communicator keyboards. Installed as /usr/share/X11/xkb/symbols/cosmo.
//
// The matrix sends the same key codes whatever is printed on the caps, so each
// physical layout needs its own symbols. Fn (which arrives as the left "Windows"
// key) selects the third level, i.e. the legends printed under each key; the
// planet/Alt key becomes Super, which is the compositor's modifier.

// Japanese keyboard, Latin input only (no kana).
default partial alphanumeric_keys modifier_keys
xkb_symbols "jp" {
    include "us(basic)"
    name[Group1] = "English (Planet Cosmo, Japanese keyboard)";

    key.type[Group1] = "FOUR_LEVEL";
    key <AE01> { [ 1, exclam,     bar,          bar          ] };
    key <AE02> { [ 2, quotedbl,   grave,        grave        ] };
    key <AE03> { [ 3, numbersign, backslash,    backslash    ] };
    key <AE04> { [ 4, dollar,     yen,          yen          ] };
    key <AE05> { [ 5, percent,    less,         less         ] };
    key <AE06> { [ 6, ampersand,  greater,      greater      ] };
    key <AE07> { [ 7, apostrophe, bracketleft,  braceleft    ] };
    key <AE08> { [ 8, parenleft,  bracketright, braceright   ] };
    key <AE09> { [ 9, parenright ] };
    key <AE10> { [ 0, asciitilde, asciicircum,  asciicircum  ] };

    // right of L, right of M, right of the space bar
    key <AC11> { [ colon,  asterisk, colon,  asterisk ] };
    key <AB09> { [ period, plus,     period, plus     ] };
    key <AB08> { [ comma,  minus,    comma,  minus    ] };

    key.type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC";
    key <AD01> { [ q, Q, Zenkaku_Hankaku,       Zenkaku_Hankaku       ] };
    key <AD02> { [ w, W, XF86AudioPrev,         XF86AudioPrev         ] };
    key <AD03> { [ e, E, XF86AudioNext,         XF86AudioNext         ] };
    key <AD05> { [ t, T, XF86AudioMicMute,      XF86AudioMicMute      ] };
    key <AD06> { [ y, Y, slash,                 slash                 ] };
    key <AD08> { [ i, I, equal,                 equal                 ] };
    key <AC02> { [ s, S, XF86AudioPlay,         XF86AudioPlay         ] };
    key <AC06> { [ h, H, underscore,            underscore            ] };
    key <AC07> { [ j, J, at,                    at                    ] };
    key <AC08> { [ k, K, question,              question              ] };
    key <AC09> { [ l, L, semicolon,             semicolon             ] };
    key <AB02> { [ x, X, XF86AudioMute,         XF86AudioMute         ] };
    key <AB03> { [ c, C, XF86AudioLowerVolume,  XF86AudioLowerVolume  ] };
    key <AB04> { [ v, V, XF86AudioRaiseVolume,  XF86AudioRaiseVolume  ] };
    key <AB05> { [ b, B, XF86MonBrightnessDown, XF86MonBrightnessDown ] };
    key <AB06> { [ n, N, XF86MonBrightnessUp,   XF86MonBrightnessUp   ] };

    key.type[Group1] = "FOUR_LEVEL";
    key <TAB>  { [ Tab,       ISO_Left_Tab, Caps_Lock, Caps_Lock ] };
    key <BKSP> { [ BackSpace, BackSpace,    Delete,    Delete    ] };
    key <LEFT> { [ Left,      Left,         Home,      Home      ] };
    key <RGHT> { [ Right,     Right,        End,       End       ] };
    key <UP>   { [ Up,        Up,           Prior,     Prior     ] };
    key <DOWN> { [ Down,      Down,         Next,      Next      ] };

    key.type[Group1] = "ONE_LEVEL";
    key <LWIN> { [ ISO_Level3_Shift ] };
    key <LALT> { [ Super_L ] };
    modifier_map Mod5 { <LWIN> };
    modifier_map Mod4 { <LALT> };
};
