#!/usr/bin/env python3
"""Diagnostics: switch the LEDs and watch the sensors.

Everything comes from sysfs, so a component shows up here as soon as its driver binds
and the list stays honest about what works: LEDs from /sys/class/leds, sensors from
IIO, temperatures from thermal zones, battery and charger from power_supply, the lid
from its input switch. LED files are writable by the video group
(90-pennyos-backlight.rules).
"""
import fcntl
import glob
import os
import struct
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk  # noqa: E402

LEDS = "/sys/class/leds"
REFRESH_MS = 500

CSS = b"""
* { font-size: 15px; }
.section { font-weight: bold; font-size: 17px; margin-top: 10px; }
.value { font-family: monospace; }
.dim { opacity: 0.6; }
"""


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError:
        return False


# ---------------------------------------------------------------- LEDs

# Where each LED is, found on the phone one LED at a time (research/leds-and-sensors.md).
# Some colour channels light nothing visible; they are marked so.
LED_PLACES = {
    "red:capslock": "Caps Lock key", "green:numlock": "Caps Lock key",
    "blue:scrolllock": "Caps Lock key",
    "red:status": "above the outer display", "green:status": "above the outer display (no visible light)",
    "blue:status": "above the outer display",
    "red:indicator": "right of the fingerprint sensor (no visible light)",
    "green:indicator": "right of the fingerprint sensor",
    "blue:indicator": "right of the fingerprint sensor",
    "blue:indicator-2": "right of the fingerprint sensor",
    "red:indicator_1": "left of the fingerprint sensor", "green:indicator_1": "left of the fingerprint sensor",
    "blue:indicator_1": "left of the fingerprint sensor",
    "rgb:indicator": "below the fingerprint sensor",
    "white:indicator": "below the fingerprint sensor (lights red)",
    "white:flash-1": "camera flash (torch)", "white:flash-2": "camera flash (torch, second channel)",
}


def describe_led(name):
    if name.endswith("kbd_backlight"):
        return "keyboard backlight"
    return LED_PLACES.get(name, "")


class LedRow:
    """One LED: on/off switch, a level slider when it has levels, colour switches
    for an RGB LED."""

    def __init__(self, grid, row, name):
        self.path = os.path.join(LEDS, name)
        self.name = name
        self.max = int(read(self.path + "/max_brightness", "1"))
        self.colors = (read(self.path + "/multi_index") or "").split()
        self.updating = False

        label = Gtk.Label(xalign=0)
        label.set_markup("<b>%s</b>\n<small>%s</small>" % (
            GLib.markup_escape_text(name), describe_led(name)))
        grid.attach(label, 0, row, 1, 1)

        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch.connect("notify::active", self.on_switch)
        grid.attach(self.switch, 1, row, 1, 1)

        box = Gtk.Box(spacing=6)
        self.scale = None
        if self.max > 1:
            self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, self.max, 1)
            self.scale.set_size_request(220, -1)
            self.scale.set_value(self.max if not name.startswith("white:flash") else 1)
            self.scale.connect("value-changed", self.on_level)
            box.pack_start(self.scale, True, True, 0)
        self.color_buttons = []
        for color in self.colors:
            b = Gtk.ToggleButton(label=color)
            b.set_active(True)
            b.connect("toggled", self.on_color)
            self.color_buttons.append(b)
            box.pack_start(b, False, False, 0)
        if name.startswith("white:flash"):
            warn = Gtk.Label(label="bright: do not look into it")
            warn.get_style_context().add_class("dim")
            box.pack_start(warn, False, False, 0)
        grid.attach(box, 2, row, 1, 1)
        self.refresh()

    def level(self):
        return int(self.scale.get_value()) if self.scale else self.max

    def apply(self, on):
        if self.colors:
            ints = [str(self.max if b.get_active() else 0) for b in self.color_buttons]
            write(self.path + "/multi_intensity", " ".join(ints))
        if not write(self.path + "/brightness", self.level() if on else 0):
            self.switch.set_tooltip_text("cannot write %s/brightness" % self.path)

    def on_switch(self, *_):
        if not self.updating:
            self.apply(self.switch.get_active())

    def on_level(self, *_):
        if self.switch.get_active():
            self.apply(True)

    def on_color(self, *_):
        if self.switch.get_active():
            self.apply(True)

    def set(self, on):
        self.switch.set_active(on)

    def refresh(self):
        on = int(read(self.path + "/brightness", "0")) > 0
        if on != self.switch.get_active():
            self.updating = True
            self.switch.set_active(on)
            self.updating = False


class LedPage(Gtk.Box):
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8, border_width=12)
        buttons = Gtk.Box(spacing=8)
        all_off = Gtk.Button(label="All off")
        all_off.connect("clicked", lambda *_: [r.set(False) for r in self.rows])
        step = Gtk.Button(label="Step through (find each LED)")
        step.connect("clicked", self.on_step)
        self.status = Gtk.Label(xalign=0)
        buttons.pack_start(all_off, False, False, 0)
        buttons.pack_start(step, False, False, 0)
        buttons.pack_start(self.status, True, True, 0)
        self.pack_start(buttons, False, False, 0)

        grid = Gtk.Grid(column_spacing=16, row_spacing=10)
        scroll = Gtk.ScrolledWindow()
        scroll.add(grid)
        self.pack_start(scroll, True, True, 0)
        names = sorted(os.listdir(LEDS)) if os.path.isdir(LEDS) else []
        self.rows = [LedRow(grid, i, n) for i, n in enumerate(names)]
        if not self.rows:
            grid.attach(Gtk.Label(label="No LEDs in /sys/class/leds"), 0, 0, 1, 1)
        self.stepping = None

    def on_step(self, *_):
        if self.stepping is not None:
            return
        # skip the flash: it is too bright to stare at in passing
        rows = [r for r in self.rows if not r.name.startswith("white:flash")]
        for r in rows:
            r.set(False)
        self.stepping = iter(rows + [None])
        self.prev = None
        GLib.timeout_add(1200, self.step_next)
        self.step_next()

    def step_next(self):
        if self.prev:
            self.prev.set(False)
        row = next(self.stepping)
        if row is None:
            self.stepping = None
            self.status.set_text("")
            return False
        row.set(True)
        self.status.set_text("now lit: " + row.name)
        self.prev = row
        return True

    def refresh(self):
        if self.stepping is None:
            for r in self.rows:
                r.refresh()


# ---------------------------------------------------------------- sensors

def iio_device(name):
    for d in glob.glob("/sys/bus/iio/devices/iio:device*"):
        if read(d + "/name") == name:
            return d
    return None


def iio_value(dev, chan, shared_scale=None):
    """(raw + offset) * scale for one channel; scale may be per channel or shared."""
    raw = read("%s/%s_raw" % (dev, chan))
    if raw is None:
        return None
    kind = chan.split("_")[1]  # in_accel_x -> accel
    scale = read("%s/%s_scale" % (dev, chan)) or read("%s/in_%s_scale" % (dev, kind))
    offset = read("%s/%s_offset" % (dev, chan)) or "0"
    return (float(raw) + float(offset)) * float(scale or 1)


EVIOCGSW = lambda n: (2 << 30) | (n << 16) | (ord("E") << 8) | 0x1B  # noqa: E731
SW_LID = 0


def lid_state():
    for ev in glob.glob("/sys/class/input/event*"):
        if read(ev + "/device/name") != "cosmo-gpio-keys":
            continue
        try:
            fd = os.open("/dev/input/" + os.path.basename(ev), os.O_RDONLY)
            try:
                bits = fcntl.ioctl(fd, EVIOCGSW(8), bytes(8))
            finally:
                os.close(fd)
        except OSError as e:
            return "cannot read (%s)" % e.strerror
        return "closed" if struct.unpack("Q", bits)[0] & (1 << SW_LID) else "open"
    return None


def fmt(v, unit, digits=2):
    return "-" if v is None else "%.*f %s" % (digits, v, unit)


def motion():
    d = iio_device("bmi160")
    if not d:
        return None
    acc = [iio_value(d, "in_accel_" + a) for a in "xyz"]
    gyr = [iio_value(d, "in_anglvel_" + a) for a in "xyz"]
    rows = [("accelerometer x / y / z", "  ".join(fmt(v, "m/s²") for v in acc))]
    rows.append(("gyroscope x / y / z", "  ".join(
        fmt(None if v is None else v * 57.29578, "°/s", 1) for v in gyr)))
    return rows


def light():
    d = iio_device("stk3310")
    if not d:
        return None
    return [("illuminance", fmt(iio_value(d, "in_illuminance"), "lux", 1)),
            ("proximity (raw, higher = nearer)", read(d + "/in_proximity_raw", "-"))]


def lid():
    s = lid_state()
    return None if s is None else [("lid", s)]


def temperatures():
    rows = []
    for z in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
        t = read(z + "/temp")
        if t is not None:
            rows.append((read(z + "/type", z), fmt(int(t) / 1000, "°C", 1)))
    d = iio_device("mt6370-adc")
    if d:
        t = iio_value(d, "in_temp8")  # IIO temperatures are in millidegrees
        rows.append(("MT6370 charger chip", fmt(None if t is None else t / 1000, "°C", 0)))
    return rows or None


def supply(name, props):
    base = "/sys/class/power_supply/" + name
    if not os.path.isdir(base):
        return None
    rows = []
    for prop, label, scale, unit in props:
        v = read("%s/%s" % (base, prop))
        if v is None:
            continue
        if scale:
            v = "%.2f %s" % (int(v) / scale, unit)
        elif unit:
            v = "%s %s" % (v, unit)
        rows.append((label, v))
    return rows


def battery():
    return supply("cosmo-battery", [
        ("capacity", "level", None, "%"), ("status", "status", None, ""),
        ("voltage_now", "voltage", 1e6, "V"), ("voltage_ocv", "open-circuit voltage", 1e6, "V"),
        ("current_now", "current (+ = charging)", 1e3, "mA"),
        ("charge_now", "charge", 1e3, "mAh"), ("charge_full", "full", 1e3, "mAh")])


def charger():
    rows = supply("mt6370-charger", [
        ("online", "connected", None, ""), ("status", "status", None, ""),
        ("input_current_limit", "input limit", 1e3, "mA"),
        ("constant_charge_current", "charge current", 1e3, "mA"),
        ("constant_charge_voltage", "charge voltage", 1e6, "V")])
    d = iio_device("mt6370-adc")
    if rows is not None and d:
        rows.append(("VBUS", fmt(iio_value(d, "in_voltage0"), "mV", 0)))
        rows.append(("input current", fmt(iio_value(d, "in_current5"), "mA", 0)))
        rows.append(("battery current (charger side)", fmt(iio_value(d, "in_current6"), "mA", 0)))
        rows.append(("system voltage", fmt(iio_value(d, "in_voltage2"), "mV", 0)))
    return rows


SECTIONS = [
    ("Motion", motion, "not supported yet: the accelerometer/gyroscope does not answer on SPI "
     "(research/leds-and-sensors.md)"),
    ("Light and proximity (STK3311)", light, "light sensor driver not loaded (stk3310)"),
    ("Lid", lid, "lid switch not found"),
    ("Temperatures", temperatures, "no thermal zones"),
    ("Battery", battery, "no fuel gauge (cosmo-battery)"),
    ("Charger (MT6370)", charger, "no charger (mt6370-charger)"),
]


class SensorPage(Gtk.ScrolledWindow):
    def __init__(self):
        super().__init__()
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, border_width=12)
        self.add(self.box)
        self.labels = {}
        self.refresh()

    def refresh(self):
        for title, fn, missing in SECTIONS:
            try:
                rows = fn()
            except (OSError, ValueError) as e:
                rows = [("error", str(e))]
            if title not in self.labels:
                head = Gtk.Label(label=title, xalign=0)
                head.get_style_context().add_class("section")
                grid = Gtk.Grid(column_spacing=24, row_spacing=2)
                self.box.pack_start(head, False, False, 0)
                self.box.pack_start(grid, False, False, 0)
                self.labels[title] = (grid, {})
            grid, cells = self.labels[title]
            shown = rows or [(missing, "")]
            for i, (label, value) in enumerate(shown):
                if label not in cells:
                    k = Gtk.Label(label=label, xalign=0)
                    v = Gtk.Label(xalign=0)
                    v.get_style_context().add_class("value")
                    if rows:
                        grid.attach(k, 0, i, 1, 1)
                        grid.attach(v, 1, i, 1, 1)
                    else:
                        k.get_style_context().add_class("dim")
                        k.set_line_wrap(True)
                        k.set_max_width_chars(60)
                        grid.attach(k, 0, i, 2, 1)
                    cells[label] = (k, v)
                cells[label][1].set_text(value)
            # a driver that appears replaces its "not loaded" line
            current = {label for label, _ in shown}
            for label, (k, v) in cells.items():
                k.set_visible(label in current)
                v.set_visible(label in current)


class Diag(Gtk.Window):
    def __init__(self):
        super().__init__(title="Diagnostics")
        self.set_default_size(1000, 600)
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        tabs = Gtk.Notebook()
        self.leds = LedPage()
        self.sensors = SensorPage()
        tabs.append_page(self.sensors, Gtk.Label(label="Sensors"))
        tabs.append_page(self.leds, Gtk.Label(label="LEDs"))
        self.add(tabs)
        self.tabs = tabs
        GLib.timeout_add(REFRESH_MS, self.tick)
        self.tick()

    def tick(self):
        self.sensors.refresh()
        self.leds.refresh()
        return True


if __name__ == "__main__":
    win = Diag()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    if sys.argv[1:] == ["leds"]:  # `penny-diag leds` opens on the LED page
        win.tabs.set_current_page(1)
    Gtk.main()
