#!/bin/sh
# "Settings" in the launcher: one menu for the settings tools that exist on this
# system, so they do not each need a launcher entry. Entries appear only when the
# tool behind them is installed.
have() { command -v "$1" >/dev/null 2>&1; }
items="Wi-Fi"
have system-config-printer && items="$items
Printers"
have thunar-settings && items="$items
File manager"
have gnome-software && items="$items
Software sources and updates"
items="$items
Power
First-time setup (name, password, language, keyboard, time zone)"
n=$(printf '%s\n' "$items" | wc -l)
choice=$(printf '%s\n' "$items" | fuzzel --dmenu --lines "$n" --width 62 --prompt "settings  ") || exit 0
case "$choice" in
  Wi-Fi)          exec /usr/local/bin/penny-wifi-menu ;;
  Printers)       exec system-config-printer ;;
  "File manager") exec thunar-settings ;;
  Software*)      exec gnome-software --mode=updates ;;
  Power)          exec /usr/local/bin/penny-power-menu ;;
  First-time*)    exec foot --title "PennyOS setup" /usr/local/bin/penny-setup ;;
esac
