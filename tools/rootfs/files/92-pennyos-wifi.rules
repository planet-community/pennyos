# Start wpa_supplicant when the Wi-Fi interface appears, instead of at a fixed point
# in boot: wlan0 only exists once penny-conn.service has powered the radio on, and
# nothing else should have to wait for that.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="wpa_supplicant@wlan0.service"
