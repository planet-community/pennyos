// PennyOS waybar for niri on the Cosmo (2160x1080 @ 1.75x -> 1234x617 logical px).
// Down the left edge: the screen is short and wide, so a side bar costs 3% of the
// width where a top bar cost 6.5% of the height. 40 px wide so the buttons are touch
// targets (~4.4 mm on this panel). Vertical, so no window title (it would not fit);
// in a vertical bar modules-left is the top, modules-right the bottom.
{
    "layer": "top",
    "position": "left",
    "width": 40,
    "spacing": 0,
    "modules-left": ["custom/launcher", "niri/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "custom/battery", "custom/overview", "custom/close", "custom/power"],

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "fuzzel"
    },
    "niri/workspaces": {
        "format": "{index}"
    },
    "clock": {
        // turned to read up the bar, to fit its width; tap for the date
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d %b}",
        "rotate": 90,
        "tooltip": false
    },
    "network": {
        // a plain Wi-Fi icon (Font Awesome "wifi"), dimmed when not connected; tap for
        // signal, address and the network list (penny-wifi-menu)
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf1eb",
        "format-disconnected": "\uf1eb",
        "format-linked": "\uf1eb",
        "tooltip-format-wifi": "{essid}  {signalStrength}%  {ipaddr}",
        "tooltip-format-disconnected": "Wi-Fi: not connected",
        "on-click": "/usr/local/bin/penny-wifi-menu",
        "interface": "wlan0"
    },
    "custom/battery": {
        "exec": "/usr/local/bin/penny-bar-battery",
        "return-type": "json",
        "justify": "center",
        "interval": 30
    },
    "custom/overview": {
        "format": "",
        "tooltip": false,
        "on-click": "niri msg action toggle-overview"
    },
    "custom/close": {
        "exec": "/usr/local/bin/penny-bar-close",
        "return-type": "json",
        "tooltip": false,
        "on-click": "niri msg action close-window"
    },
    "custom/power": {
        // Font Awesome "power-off"
        "format": "\uf011",
        "tooltip": false,
        "on-click": "/usr/local/bin/penny-power-menu"
    }
}
