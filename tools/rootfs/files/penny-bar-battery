#!/bin/sh
# waybar custom module: battery level and charging state.
# The level comes from the fuel gauge (cosmo-battery, kernel/drivers/cosmo_fg.c). On a
# kernel without it, fall back to a rough estimate from the cell voltage (MT6370 ADC).
B=/sys/class/power_supply/cosmo-battery
CHG=/sys/class/power_supply/mt6370-charger
if pct=$(cat $B/capacity 2>/dev/null); then
  st=$(cat $B/status)
  mv=$(( $(cat $B/voltage_now) / 1000 ))
  ma=$(( $(cat $B/current_now) / 1000 ))
  mah=$(( $(cat $B/charge_now) / 1000 ))
  note="$mah mAh, $ma mA"
else
  d=$(grep -l mt6370-adc /sys/bus/iio/devices/iio:device*/name 2>/dev/null | head -1 | xargs -r dirname)
  [ -n "$d" ] || { echo '{"text":"","tooltip":"no battery data"}'; exit 0; }
  raw=$(cat "$d/in_voltage3_raw" 2>/dev/null) || exit 0
  mv=$((raw * 5))
  st=$(cat $CHG/status 2>/dev/null)
  # open-circuit-ish estimate, 3.40 V = 0 %, 4.20 V = 100 %; reads high while charging
  pct=$(( (mv - 3400) * 100 / 800 )); [ $pct -lt 0 ] && pct=0; [ $pct -gt 100 ] && pct=100
  note="estimated from voltage"
fi
if [ "$st" = Charging ] || [ "$st" = Full ]; then icon=""; cls=charging
elif [ $pct -le 15 ]; then icon=""; cls=low
elif [ $pct -le 50 ]; then icon=""; cls=normal
else icon=""; cls=normal; fi
# icon above the number: the bar is vertical and only 40 px wide
printf '{"text":"%s\\n%d%%","tooltip":"%d.%02d V  %s  (%s)","class":"%s"}\n' \
  "$icon" "$pct" $((mv / 1000)) $(((mv % 1000) / 10)) "${st:-unknown}" "$note" "$cls"
