#!/bin/sh
# Speaker volume: penny-volume up | down | mute
#
# Fn+V / Fn+C / Fn+X, as printed on the keyboard. Moves the software "Master"
# control of the default device (/etc/asound.conf, -50..0 dB) in 10 % steps on
# ALSA's perceptual scale (amixer -M), so every step sounds about as big. Below
# the lowest step the speakers are switched off ("Speakers Switch"). Shows the
# level as a notification with a bar, replaced on each press. alsactl saves the
# level at shutdown.
CARD=cosmo
STEP=10
pct() { amixer -M -c $CARD get Master | sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -n 1; }
on=$(amixer -c $CARD cget name="Speakers Switch" | sed -n 's/^ *: values=//p')
cur=$(pct)
[ -n "$cur" ] && [ -n "$on" ] || { echo "no volume control (has anything played yet?)" >&2; exit 1; }

case "$1" in
  up)
    # muted: come back at the level it had
    if [ "$on" = off ]; then on=on
    else amixer -q -M -c $CARD sset Master "$STEP%+"; fi ;;
  down)
    if [ "$on" = on ] && [ "$cur" -le "$STEP" ]; then on=off
    else amixer -q -M -c $CARD sset Master "$STEP%-"; fi ;;
  mute)
    [ "$on" = on ] && on=off || on=on ;;
  *) echo "usage: $0 up|down|mute" >&2; exit 1 ;;
esac
amixer -q -c $CARD cset name="Speakers Switch" "$on"

level=$(pct)
if [ "$on" = off ]; then level=0; icon=audio-volume-muted; text="Muted"
else
  if [ "$level" -le 30 ]; then icon=audio-volume-low
  elif [ "$level" -le 70 ]; then icon=audio-volume-medium
  else icon=audio-volume-high; fi
  text="$level %"
fi
notify-send -t 1500 -a penny-volume -i "$icon" -h int:value:$level \
  -h string:x-canonical-private-synchronous:penny-volume "Volume" "$text" 2>/dev/null
exit 0
