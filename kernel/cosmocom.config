# Cosmo Communicator (MT6771) — kernel config fragment.
# Merged on top of `arch/arm64/configs/defconfig` (which already provides the MTK
# platform, SERIAL_8250_MT6577 console, MMC_MTK, USB_MTU3, REGULATOR_MT6358, etc.).
# Run `make olddefconfig` after merging to resolve dependencies; symbols whose deps
# are unmet get dropped (kbuild.sh `config` prints which of these actually stuck).

# --- Cosmo-specific out-of-tree drivers (present in the affenull2345 mt6771 tree) ---
CONFIG_KEYBOARD_GPIO_FASTMATRIX=y
CONFIG_PINCTRL_AW9523=y

# --- Display: Cosmo panel lives in panel-simple; MTK DRM for the DSI ---
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANEL_SIMPLE=y

# --- GPU (Mali-G72) ---
CONFIG_DRM_PANFROST=y

# --- MT6370 sub-PMIC family: charger / backlight / regulators / ADC / USB-C TCPC ---
CONFIG_MFD_MT6370=y
CONFIG_REGULATOR_MT6370=y
CONFIG_CHARGER_MT6370=y
CONFIG_BACKLIGHT_MT6370=y
CONFIG_MEDIATEK_MT6370_ADC=y

# --- USB-C / Type-C Port Manager (MT6370 TCPC + USB role switch in the DT) ---
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6370=y

# --- Bring-up conveniences ---
CONFIG_REGULATOR_MT6358=y
CONFIG_IRQ_MTK_SYSIRQ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y

# --- USB serial-gadget console (feedback over the existing USB-C cable) ---
# MTU3 is already DUAL_ROLE (UDC in peripheral mode). Build the legacy g_serial
# gadget + tty console in so the kernel auto-exposes ttyGS0 with no userspace.
# On the host Mac this enumerates as /dev/tty.usbmodem*. Pair with
# `console=ttyGS0,115200` on the cmdline (see tools/mkboot.sh).
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_G_SERIAL=y

# --- Multimedia subsystem: mmsys spawns the mm clock driver that the DISP power
# domain needs; as a module (the default) the whole power controller defers. ---
CONFIG_MTK_CMDQ=y
CONFIG_MTK_MMSYS=y

# --- Keyboard backlight: SoC PWM_A -> pwm-leds (devicetree/pennyos-kbd-backlight.dtsi) ---
CONFIG_PWM_MEDIATEK=y
CONFIG_LEDS_PWM=y
