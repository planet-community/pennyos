# Additions for booting a real distro root filesystem. Merged AFTER slim + debug.

# What systemd / a normal userland expects that slim.config removed
CONFIG_IPV6=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUPS=y
CONFIG_AUTOFS_FS=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y

# Snap packages are squashfs images, mostly xz-compressed (some lzo). defconfig builds
# squashfs in with zlib only; XZ_DEC and LZO_DECOMPRESS are already built in, so these
# add only the small squashfs glue to Image.
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y

# USB: CDC composite gadget = ACM serial console (ttyGS0) + ECM ethernet (usb0),
# both driverless on macOS. Replaces the serial-only g_serial.
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_CDC_COMPOSITE=y
CONFIG_USB_U_ETHER=y

# Display stack BUILT IN: it must have claimed its clocks and power domain before the
# kernel switches off unused ones at the end of boot (we no longer pass
# clk_ignore_unused / pd_ignore_unused). mediatek/ links before panel/, so the DSI
# host registers before the panel driver and the 6.4 mtk_dsi bind-order bug is avoided.
# The GPU stays a module: its domain may be off until panfrost loads.
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_PANEL_PLANET_SSD2092=y
CONFIG_DRM_PANFROST=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_MT6370=y
CONFIG_PWM_MTK_DISP=m
CONFIG_PHY_MTK_MIPI_DSI=y

# Battery / charger
CONFIG_BATTERY_COSMO_FG=m
CONFIG_CHARGER_MT6370=m
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6370_ADC=m

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Compressed swap in RAM (zram-generator sets it up at boot). A module, and its zstd
# compressor is already one, so Image does not grow. No CONFIG_PSI, which would be
# built in: earlyoom, which handles low memory, reads /proc/meminfo instead.
CONFIG_ZRAM=m

# Main-panel touch on SSD2092 units (kernel/drivers/ssd20xx.c)
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SSD20XX=m

# Wi-Fi: cfg80211 for the out-of-tree vendor "wlan gen3" driver (kernel/connectivity).
# It also needs wireless extensions (private ioctls) and nl80211 testmode; WIRELESS_EXT
# and WEXT_PRIV can only be select-ed, hence kernel/patches/0007.
CONFIG_WIRELESS=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_NL80211_TESTMODE=y
CONFIG_MTK_WLAN_GEN3_WEXT=y
# the same DMA engine is driven directly by the Wi-Fi driver
# CONFIG_MTK_CQDMA is not set

# Bluetooth host stack. The controller arrives through hci_vhci, fed by
# tools/wmt/penny-btd from the vendor driver's /dev/stpbt.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIVHCI=m
CONFIG_UHID=m

# Sound, all as modules (the built-in image must stay small for LK): SoC audio front
# end (the MT8183 driver fits the MT6771), MT6358 codec, and the Cosmo card
# (kernel/drivers/cosmo-sound.c)
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_MT8183=m
CONFIG_SND_SOC_MT6358=m
CONFIG_SND_SOC_COSMO=m

# SoC temperature: the MT8183 AUXADC thermal driver fits the MT6771 (same controller
# at 0x1100b000, calibration in efuse). Without it there are no thermal zones and the
# kernel's critical-temperature shutdown cannot fire.
CONFIG_MTK_THERMAL=m
CONFIG_MTK_SOC_THERMAL=m

# LEDs on the MT6370: the RGB + white indicator and the two camera flash LEDs (nodes
# already in the board DTS). Flash class without V4L2: the LEDs are driven from sysfs.
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_MT6370_RGB=m
CONFIG_LEDS_MT6370_FLASH=m

# Sensors (devicetree/pennyos-sensors.dtsi): STK3311-X light/proximity on i2c1
CONFIG_STK3310=m
