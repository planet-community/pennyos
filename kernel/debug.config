# Blind bring-up aids. Merged AFTER cosmocom.config and slim.config.

# pstore/ramoops black box, laid out to match the vendor kernel so that
# Android can read our log back after a warm reset (see devicetree/pennyos-debug.dtsi).
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# The vendor 4.4 kernel cannot decompress modern pstore records.
# CONFIG_PSTORE_COMPRESS is not set

# Console on the framebuffer LK left running (simple-framebuffer), no DRM needed.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# LK hands over with the watchdog armed; the driver must be built in to feed it.
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y

CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=18

# Leave the backlight exactly as LK set it (simplefb is our display for now).
# CONFIG_BACKLIGHT_MT6370 is not set
# CONFIG_PSTORE_DEFLATE_COMPRESS is not set
