# Aggressive slim fragment — shrink the BUILTIN kernel (the decompressed Image is
# what MediaTek LK gunzips into a fixed buffer; ours was ~40 MB vs the vendor's ~25 MB,
# and LK errors with "gunzip header is bigger than expectation"). Disabling modules
# does NOT help — only builtin (=y) code shrinks Image. Keep boot essentials: MTK SoC
# core, serial console, eMMC, USB serial gadget, ext4/vfat/configfs, Cosmo drivers.
# Merged AFTER cosmocom.config.

# Display / GPU / media / sound — no usable early display on mainline anyway
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_LOGO is not set

# Networking: keep core (deps) but drop the big optional stacks/drivers
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set
# CONFIG_ETHERNET is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_INET_DIAG is not set
# CONFIG_XFRM_USER is not set
# CONFIG_BPF_SYSCALL is not set

# Storage stacks we don't use (eMMC uses MMC block, not SCSI/ATA/NVME/MD/MTD)
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_MTD is not set
# CONFIG_TARGET_CORE is not set
# CONFIG_NVMEM_LAYOUTS is not set

# Filesystems: keep ext4/vfat/tmpfs/configfs/proc/sysfs; drop the big others
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set
# CONFIG_CIFS is not set
# CONFIG_NTFS3_FS is not set

# Big misc subsystems not needed to reach a shell
# CONFIG_IIO is not set
# CONFIG_INFINIBAND is not set
# CONFIG_HID_MULTITOUCH is not set
# CONFIG_DRM_DISPLAY_HELPER is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_CAN is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_WATCHDOG_PRETIMEOUT_GOV is not set
# CONFIG_CPU_FREQ is not set

# Kernel-size / debug trims (Image size + build speed)
# CONFIG_DEBUG_INFO is not set
# CONFIG_KALLSYMS_ALL is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
