diff --git a/drivers/usb/mtu3/mtu3_core.c b/drivers/usb/mtu3/mtu3_core.c
index a3a628289..b1fb7bac2 100644
--- a/drivers/usb/mtu3/mtu3_core.c
+++ b/drivers/usb/mtu3/mtu3_core.c
@@ -660,7 +660,13 @@ static void mtu3_regs_init(struct mtu3 *mtu)
 	/* U2/U3 detected by HW */
 	mtu3_writel(mbase, U3D_DEVICE_CONF, 0);
 	/* vbus detected by HW */
-	mtu3_clrbits(mbase, U3D_MISC_CTRL, VBUS_FRC_EN | VBUS_ON);
+	/*
+	 * pennyos: the SSUSB VBUS-valid input is not wired on the Cosmo (the
+	 * vendor kernel connects on charger detection), so the MAC never sees a
+	 * session and the gadget stays "not attached". Force VBUS valid, as
+	 * upstream later made possible with the "mediatek,force-vbus" property.
+	 */
+	mtu3_setbits(mbase, U3D_MISC_CTRL, VBUS_FRC_EN | VBUS_ON);
 	/* use new QMU format when HW version >= 0x1003 */
 	if (mtu->gen2cp)
 		mtu3_writel(mbase, U3D_QFCR, ~0x0);
