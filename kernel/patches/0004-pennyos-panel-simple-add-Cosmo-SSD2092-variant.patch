+ * initialised the panel; there is no reset/init sequence here yet.
+ */
+static const struct drm_display_mode planet_cosmocom_ssd2092_mode = {
+	.clock = 154584,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 26,
+	.hsync_end = 1080 + 26 + 4,
+	.htotal = 1080 + 26 + 4 + 20,
+	.vdisplay = 2160,
+	.vsync_start = 2160 + 76,
+	.vsync_end = 2160 + 76 + 1,
+	.vtotal = 2160 + 76 + 1 + 43,
+	.flags = DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+};
+
+static const struct panel_desc_dsi planet_cosmocom_ssd2092 = {
+	.desc = {
+		.modes = &planet_cosmocom_ssd2092_mode,
+		.num_modes = 1,
+		.bpc = 8,
+		.size = {
+			.width = 68,
+			.height = 136,
+		},
+		.connector_type = DRM_MODE_CONNECTOR_DSI,
+	},
+	.flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+		 MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	.format = MIPI_DSI_FMT_RGB888,
+	.lanes = 4,
+};
