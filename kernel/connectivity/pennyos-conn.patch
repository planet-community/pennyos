diff --git a/compat/pennyos_compat.h b/compat/pennyos_compat.h
new file mode 100644
index 0000000..2db9d9b
--- /dev/null
+++ b/compat/pennyos_compat.h
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * pennyos_compat.h - maps Linux 4.4-era kernel APIs used by the MediaTek
+ * connectivity drivers onto Linux 6.4.
+ *
+ * Force-included (-include) into every translation unit from the top-level
+ * Kbuild.  Only APIs that mainline removed or renamed live here; services
+ * that only ever existed in the MediaTek vendor kernel are in
+ * pennyos_shim.[ch].
+ */
+#ifndef _PENNYOS_COMPAT_H_
+#define _PENNYOS_COMPAT_H_
+
+#ifndef __ASSEMBLY__
+
+#include <linux/version.h>
+#include <linux/types.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/time.h>
+#include <linux/ktime.h>
+#include <linux/timekeeping.h>
+#include <linux/rtc.h>
+#include <linux/io.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/pm_wakeup.h>
+#include <linux/sched.h>
+#include <linux/sched/clock.h>		/* local_clock() */
+#include <linux/sched/signal.h>		/* signal_pending(), for_each_process() */
+#include <linux/sched/debug.h>		/* show_stack() prototype */
+#include <linux/sched/task.h>
+#include <linux/uaccess.h>
+#include <linux/vmalloc.h>
+#include <linux/slab.h>
+
+/* ------------------------------------------------------------------------
+ * struct timeval / struct timespec / do_gettimeofday()
+ *
+ * Removed from the kernel in 5.x.  The drivers only use them for log time
+ * stamps and elapsed-time arithmetic, so plain structs filled from the
+ * 64-bit clock are equivalent (tv_sec is 64 bit on arm64).
+ * ------------------------------------------------------------------------ */
+struct timeval {
+	__kernel_old_time_t	tv_sec;		/* seconds */
+	__kernel_suseconds_t	tv_usec;	/* microseconds */
+};
+
+struct timespec {
+	__kernel_old_time_t	tv_sec;		/* seconds */
+	long			tv_nsec;	/* nanoseconds */
+};
+
+static inline void do_gettimeofday(struct timeval *tv)
+{
+	struct timespec64 now;
+
+	ktime_get_real_ts64(&now);
+	tv->tv_sec = now.tv_sec;
+	tv->tv_usec = now.tv_nsec / NSEC_PER_USEC;
+}
+
+static inline struct timespec ktime_to_timespec(ktime_t kt)
+{
+	struct timespec64 ts64 = ktime_to_timespec64(kt);
+	struct timespec ts = { .tv_sec = ts64.tv_sec, .tv_nsec = ts64.tv_nsec };
+
+	return ts;
+}
+
+/* rtc_time_to_tm(unsigned long, struct rtc_time *) -> rtc_time64_to_tm() */
+#define rtc_time_to_tm(time, tm)	rtc_time64_to_tm((time64_t)(time), (tm))
+
+/* ------------------------------------------------------------------------
+ * I/O mapping, DMA
+ * ------------------------------------------------------------------------ */
+#define ioremap_nocache(addr, size)	ioremap((addr), (size))
+
+/* dma_alloc_coherent() always returns zeroed memory since 5.0 */
+#define dma_zalloc_coherent(dev, size, handle, gfp) \
+	dma_alloc_coherent((dev), (size), (handle), (gfp))
+
+/* ------------------------------------------------------------------------
+ * driver attributes: DRIVER_ATTR() was removed in 4.14 (only the _RW/_RO/_WO
+ * forms remain).  This is the 4.4 definition.
+ * ------------------------------------------------------------------------ */
+#ifndef DRIVER_ATTR
+#define DRIVER_ATTR(_name, _mode, _show, _store) \
+	struct driver_attribute driver_attr_##_name = \
+		__ATTR(_name, _mode, _show, _store)
+#endif
+
+/* ------------------------------------------------------------------------
+ * wakeup sources (what Android wakelocks were built on in 4.4)
+ *
+ * 4.4: wakeup_source_register(name), wakeup_source_init(ws, name) for an
+ *      embedded struct wakeup_source, wakeup_source_trash(ws).
+ * 6.4: wakeup_source_register(dev, name); the embedded-struct helpers were
+ *      removed but wakeup_source_add()/wakeup_source_remove() remain.
+ * ------------------------------------------------------------------------ */
+#define wakeup_source_register(name)	wakeup_source_register(NULL, (name))
+
+static inline void wakeup_source_init(struct wakeup_source *ws, const char *name)
+{
+	if (ws) {
+		memset(ws, 0, sizeof(*ws));
+		ws->name = name;
+	}
+	wakeup_source_add(ws);
+}
+
+static inline void wakeup_source_trash(struct wakeup_source *ws)
+{
+	wakeup_source_remove(ws);
+	__pm_relax(ws);
+}
+
+/* ------------------------------------------------------------------------
+ * Wi-Fi driver (wlan gen3) additions
+ * ------------------------------------------------------------------------ */
+
+/* get_monotonic_boottime(struct timespec *) was removed in 5.x */
+static inline void get_monotonic_boottime(struct timespec *ts)
+{
+	struct timespec64 now;
+
+	ktime_get_boottime_ts64(&now);
+	ts->tv_sec = now.tv_sec;
+	ts->tv_nsec = now.tv_nsec;
+}
+
+/* netif_rx_ni() was folded into netif_rx() in 5.18 (netif_rx() may now be
+ * called from any context).
+ */
+#define netif_rx_ni(skb)	netif_rx(skb)
+
+/* MODULE_SUPPORTED_DEVICE() was a no-op and was removed in 5.12 */
+#ifndef MODULE_SUPPORTED_DEVICE
+#define MODULE_SUPPORTED_DEVICE(name)
+#endif
+
+/*
+ * set_fs()/get_fs()/mm_segment_t were removed in 5.10/5.18.  The drivers
+ * only used them to bracket in-kernel file I/O on kernel buffers; every such
+ * call site now uses kernel_read()/kernel_write(), which need no address
+ * limit switch, so the bracketing calls are no-ops.
+ */
+typedef struct { int unused; } mm_segment_t;
+#define KERNEL_DS	((mm_segment_t) { 0 })
+#define get_ds()	KERNEL_DS
+#define get_fs()	KERNEL_DS
+#define set_fs(x)	((void)(x))
+
+#endif /* !__ASSEMBLY__ */
+#endif /* _PENNYOS_COMPAT_H_ */
diff --git a/compat/pennyos_shim.c b/compat/pennyos_shim.c
