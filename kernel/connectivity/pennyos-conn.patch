+		(((unsigned int) d9) << 3) | ((unsigned int) d8); \
+	apc_ary[0] = \
+		(((unsigned int) d7) << 21) | (((unsigned int) d6) << 18) | \
+		(((unsigned int) d5) << 15) | (((unsigned int) d4) << 12) | \
+		(((unsigned int) d3) << 9) | (((unsigned int) d2) << 6) | \
+		(((unsigned int) d1) << 3) | ((unsigned int) d0) | \
