@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * pennyos_shim.c - logging stubs for MediaTek vendor-kernel-only services
+ * used by the connectivity drivers (btif, wmt_drv, bt_drv).
+ *
+ * None of these services exist in mainline Linux.  Each stub prints its name
+ * and arguments once (pr_info) so that it is visible on the device which of
+ * them the drivers really call, and returns the value the vendor
+ * implementation returns on success.  Each one needs a real implementation
+ * (or a decision that it is not needed) during hardware bring-up.
+ */
+#undef pr_fmt
+#define pr_fmt(fmt) "pennyos_shim: " fmt
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/stdarg.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include "pennyos_shim.h"
+
+/* print "<function>(<args>) [stub]" the first time each stub is reached */
+#define SHIM_STUB_CALLED(fmt, ...) \
+	pr_info_once("%s(" fmt ") [stub]\n", __func__, ##__VA_ARGS__)
+
+/* ------------------------------------------------------------------------
+ * AEE / AED
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+void aee_kernel_warning_api(const char *file, const int line, const int db_opt,
+			    const char *module, const char *msg, ...)
+{
+	SHIM_STUB_CALLED("file=%s, line=%d, db_opt=0x%x, module=%s, msg=%s",
+			 file, line, db_opt, module, msg);
+}
+EXPORT_SYMBOL(aee_kernel_warning_api);
+
+/* TODO(pennyos): real implementation */
+void aee_kernel_dal_api(const char *file, const int line, const char *msg)
+{
+	SHIM_STUB_CALLED("file=%s, line=%d, msg=%s", file, line, msg);
+}
+EXPORT_SYMBOL(aee_kernel_dal_api);
+
+/* TODO(pennyos): real implementation */
+void aed_combo_exception_api(const int *log, int log_size, const int *phy,
+			     int phy_size, const char *detail, const int db_opt)
+{
+	SHIM_STUB_CALLED("log=%p, log_size=%d, phy=%p, phy_size=%d, detail=%p, db_opt=0x%x",
+			 log, log_size, phy, phy_size, detail, db_opt);
+}
+EXPORT_SYMBOL(aed_combo_exception_api);
+
+/* ------------------------------------------------------------------------
+ * PMIC raw register access
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+unsigned int pmic_read_interface(unsigned int RegNum, unsigned int *val,
+				 unsigned int MASK, unsigned int SHIFT)
+{
+	SHIM_STUB_CALLED("RegNum=0x%x, val=%p, MASK=0x%x, SHIFT=%u",
+			 RegNum, val, MASK, SHIFT);
+	if (val)
+		*val = 0;
+	return 0;
+}
+EXPORT_SYMBOL(pmic_read_interface);
+
+/* TODO(pennyos): real implementation */
+unsigned int pmic_config_interface(unsigned int RegNum, unsigned int val,
+				   unsigned int MASK, unsigned int SHIFT)
+{
+	SHIM_STUB_CALLED("RegNum=0x%x, val=0x%x, MASK=0x%x, SHIFT=%u",
+			 RegNum, val, MASK, SHIFT);
+	return 0;
+}
+EXPORT_SYMBOL(pmic_config_interface);
+
+static const char *shim_pmu_flag_name(PMU_FLAGS_LIST_ENUM flagname)
+{
+	switch (flagname) {
+	case PMIC_RG_LDO_VCN28_HW0_OP_EN:
+		return "PMIC_RG_LDO_VCN28_HW0_OP_EN";
+	case PMIC_RG_LDO_VCN28_HW0_OP_CFG:
+		return "PMIC_RG_LDO_VCN28_HW0_OP_CFG";
+	default:
+		return "?";
+	}
+}
+
+/*
+ * MT6358 register access. In mainline the PMIC sits behind the pwrap bus, whose
+ * driver owns the regmap; the MFD core device ("mediatek,mt6358") is its child.
+ */
+static struct regmap *shim_pmic_regmap(void)
+{
+	static struct regmap *map;
+	struct device_node *np;
+	struct platform_device *pdev;
+
+	if (map)
+		return map;
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6358");
+	if (!np)
+		return NULL;
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return NULL;
+	map = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!map)
+		pr_err("no regmap behind the MT6358 device\n");
+	return map;
+}
+
+static int shim_pmic_update(unsigned int reg, unsigned int mask, unsigned int val)
+{
+	struct regmap *map = shim_pmic_regmap();
+	unsigned int before = 0, after = 0;
+	int ret;
+
+	if (!map) {
+		pr_err("PMIC regmap unavailable, reg 0x%x not written\n", reg);
+		return -ENODEV;
+	}
+	regmap_read(map, reg, &before);
+	ret = regmap_update_bits(map, reg, mask, val);
+	regmap_read(map, reg, &after);
+	pr_info("pmic reg 0x%04x: 0x%04x -> 0x%04x (mask 0x%x val 0x%x) ret %d\n",
+		reg, before, after, mask, val, ret);
+	return ret;
+}
+
+unsigned short pmic_set_register_value(PMU_FLAGS_LIST_ENUM flagname,
+				       unsigned int val)
+{
+	/* both fields used by the consys code are 1 bit wide at shift 1 */
+	switch (flagname) {
+	case PMIC_RG_LDO_VCN28_HW0_OP_EN:
+		shim_pmic_update(MT6358_LDO_VCN28_OP_EN, 0x1 << 1, (val & 0x1) << 1);
+		break;
+	case PMIC_RG_LDO_VCN28_HW0_OP_CFG:
+		shim_pmic_update(MT6358_LDO_VCN28_OP_CFG, 0x1 << 1, (val & 0x1) << 1);
+		break;
+	default:
+		pr_err("pmic_set_register_value: unknown field %d\n", flagname);
+		break;
+	}
+	return 0;
+}
+EXPORT_SYMBOL(pmic_set_register_value);
+
+/* TODO(pennyos): real implementation */
+unsigned short pmic_get_register_value(PMU_FLAGS_LIST_ENUM flagname)
+{
+	SHIM_STUB_CALLED("flagname=%d (%s)",
+			 flagname, shim_pmu_flag_name(flagname));
+	return 0;
+}
+EXPORT_SYMBOL(pmic_get_register_value);
+
+void upmu_set_reg_value(unsigned int reg, unsigned int reg_val)
+{
+	shim_pmic_update(reg, 0xffff, reg_val);
+}
+EXPORT_SYMBOL(upmu_set_reg_value);
+
+/* ------------------------------------------------------------------------
+ * clock buffer
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+bool clk_buf_ctrl(enum clk_buf_id id, bool onoff)
+{
+	SHIM_STUB_CALLED("id=%d, onoff=%d", id, onoff);
+	return 0;	/* vendor: 0 = done, non-zero = refused */
+}
+EXPORT_SYMBOL(clk_buf_ctrl);
+
+/* TODO(pennyos): real implementation */
+bool is_clk_buf_from_pmic(void)
+{
+	SHIM_STUB_CALLED("");
+	return true;	/* MT6771 + MT6358: the clock buffer is in the PMIC */
+}
+EXPORT_SYMBOL(is_clk_buf_from_pmic);
+
+/* ------------------------------------------------------------------------
+ * EMI MPU
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+int emi_mpu_set_protection(struct emi_region_info_t *region_info)
+{
+	if (region_info)
+		SHIM_STUB_CALLED("start=0x%llx, end=0x%llx, region=%u, apc[0]=0x%x, apc[1]=0x%x",
+				 region_info->start, region_info->end,
+				 region_info->region, region_info->apc[0],
+				 region_info->apc[1]);
+	else
+		SHIM_STUB_CALLED("region_info=NULL");
+	return 0;
+}
+EXPORT_SYMBOL(emi_mpu_set_protection);
+
+/* ------------------------------------------------------------------------
+ * RTC 32k output
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+void rtc_gpio_enable_32k(enum rtc_gpio_user_t user)
+{
+	SHIM_STUB_CALLED("user=%d", user);
+}
+EXPORT_SYMBOL(rtc_gpio_enable_32k);
+
+/* ------------------------------------------------------------------------
+ * conn_md (modem coexistence bridge)
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+int mtk_conn_md_bridge_reg(uint32 u_id, struct conn_md_bridge_ops *p_ops)
+{
+	SHIM_STUB_CALLED("u_id=0x%x, p_ops=%p", u_id, p_ops);
