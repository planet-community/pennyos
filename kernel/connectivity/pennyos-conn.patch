new file mode 100644
index 0000000..52d072c
--- /dev/null
+++ b/Kbuild
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# pennyos: out-of-tree build of the MediaTek connectivity stack
+# (BTIF + WMT/STP + BT char driver + Wi-Fi "wlan gen3") against mainline
+# Linux 6.4.
+#
+# The vendor Makefiles are left untouched next to the Kbuild files; kbuild
+# prefers a "Kbuild" file over "Makefile", so only the Kbuild files are used.
+#
+# Vendor configuration reproduced here (Planet Cosmo Communicator, MT6771):
+#   CONFIG_MTK_PLATFORM="mt6771"  CONFIG_MTK_COMBO_CHIP="CONSYS_6771"
+#   CONFIG_MTK_COMBO=m  CONFIG_MTK_BTIF  CONFIG_MTK_COMBO_BT  CONFIG_MTK_COMBO_WIFI
+
+PENNYOS_ROOT := $(src)
+
+# Vendor Kconfig symbols that the sources test with #ifdef and that the
+# vendor defconfig sets.  They do not exist in mainline, so pass them as -D.
+PENNYOS_VENDOR_CONFIG := \
+	-DCONFIG_MACH_MT6771=1 \
+	-DCONFIG_MTK_COMBO=1 \
+	-DCONFIG_MTK_BTIF=1 \
+	-DCONFIG_MTK_COMBO_BT=1 \
+	-DCONFIG_MTK_COMBO_GPS=1 \
+	-DCONFIG_MTK_COMBO_WIFI=1 \
+	-DCONFIG_MTK_FMRADIO=1 \
+	-DCONFIG_MTK_EMI=1 \
+	-DCONFIG_MTK_GIC_V3_EXT=1
+
+subdir-ccflags-y += $(PENNYOS_VENDOR_CONFIG)
+subdir-ccflags-y += -I$(PENNYOS_ROOT)/compat/include -I$(PENNYOS_ROOT)/compat
+subdir-ccflags-y += -include $(PENNYOS_ROOT)/compat/pennyos_compat.h
+# The vendor tree builds with -Werror; this port does not.
+subdir-ccflags-y += -Wno-error
+
+export PENNYOS_ROOT
+
+obj-m += compat/
+obj-m += btif/
+obj-m += connectivity/
