diff --git a/compat/pennyos_shim.h b/compat/pennyos_shim.h
new file mode 100644
index 0000000..774b741
--- /dev/null
+++ b/compat/pennyos_shim.h
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * pennyos_shim.h - declarations for services that only exist in the
+ * MediaTek vendor (Android 4.4) kernel and have no mainline counterpart.
+ *
+ * Every function declared here is implemented as a logging stub in
+ * pennyos_shim.c (module pennyos_shim.ko).  The constants, enums and
+ * structs are copied from the vendor headers named in each section so that
+ * the callers compile unchanged and a later real implementation gets the
+ * same values the vendor kernel used.
+ *
+ * The vendor header names the drivers #include (aee.h, upmu_common.h,
+ * mtk_clkbuf_ctl.h, mt_emi_api.h, conn_md_exp.h, ...) are small forwarding
+ * headers in compat/include/ that all include this file.
+ */
+#ifndef _PENNYOS_SHIM_H_
+#define _PENNYOS_SHIM_H_
+
+#include <linux/types.h>
+#include <linux/compiler.h>
+
+struct task_struct;
+struct mmc_card;
+
+/* ------------------------------------------------------------------------
+ * AEE / AED ("Android Exception Engine") crash and warning reporting
+ * vendor: drivers/misc/mediatek/include/mt-plat/aee.h
+ * ------------------------------------------------------------------------ */
+#define DB_OPT_DEFAULT			(0)
+#define DB_OPT_FTRACE			(1<<0)
+#define DB_OPT_WCN_ISSUE_INFO		(1<<19)
+
+void aee_kernel_warning_api(const char *file, const int line, const int db_opt,
+			    const char *module, const char *msg, ...);
+void aee_kernel_dal_api(const char *file, const int line, const char *msg);
+void aed_combo_exception_api(const int *log, int log_size, const int *phy,
+			     int phy_size, const char *detail, const int db_opt);
+
+#define aee_kernel_warning(module, msg...)	\
+	aee_kernel_warning_api(__FILE__, __LINE__, DB_OPT_DEFAULT, module, msg)
+#define aee_kernel_dal_show(msg)	\
+	aee_kernel_dal_api(__FILE__, __LINE__, msg)
+#define aed_combo_exception(log, log_size, phy, phy_size, detail)	\
+	aed_combo_exception_api(log, log_size, phy, phy_size, detail, DB_OPT_DEFAULT)
+
+/* ------------------------------------------------------------------------
+ * PMIC (MT6358) raw register access
+ * vendor: include/mt-plat/upmu_common.h,
+ *         include/mt-plat/mt6771/include/mach/upmu_hw.h
+ * ------------------------------------------------------------------------ */
+/* register addresses (MT6358_PMIC_REG_BASE is 0) */
+#define MT6358_LDO_VCN18_OP_EN		((unsigned int)0x1c5a)
+#define MT6358_LDO_VCN33_OP_EN		((unsigned int)0x1d1e)
+#define MT6358_LDO_VCN28_OP_EN		((unsigned int)0x1d8a)
+#define MT6358_LDO_VCN28_OP_CFG		((unsigned int)0x1d90)
+
+/*
+ * The vendor PMU_FLAGS_LIST_ENUM is a ~2700 entry auto-numbered list of
+ * register bit fields.  Only the fields the MT6771 consys code touches are
+ * kept; the numeric values are private to the shim (not the vendor's).
+ *
+ *   field                          register                  mask  shift
+ *   PMIC_RG_LDO_VCN28_HW0_OP_EN    MT6358_LDO_VCN28_OP_EN    0x1   1
+ *   PMIC_RG_LDO_VCN28_HW0_OP_CFG   MT6358_LDO_VCN28_OP_CFG   0x1   1
+ */
+typedef enum {
+	PMIC_RG_LDO_VCN28_HW0_OP_EN = 1,
+	PMIC_RG_LDO_VCN28_HW0_OP_CFG,
+	PMU_COMMAND_MAX
+} PMU_FLAGS_LIST_ENUM;
+
+unsigned int pmic_read_interface(unsigned int RegNum, unsigned int *val,
+				 unsigned int MASK, unsigned int SHIFT);
+unsigned int pmic_config_interface(unsigned int RegNum, unsigned int val,
+				   unsigned int MASK, unsigned int SHIFT);
+unsigned short pmic_set_register_value(PMU_FLAGS_LIST_ENUM flagname,
+				       unsigned int val);
+unsigned short pmic_get_register_value(PMU_FLAGS_LIST_ENUM flagname);
+void upmu_set_reg_value(unsigned int reg, unsigned int reg_val);
+
+/* ------------------------------------------------------------------------
+ * 26 MHz clock buffer control (XO_WCN output of the PMIC / RF clock buffer)
+ * vendor: base/power/include/clkbuf_v1/mtk_clkbuf_ctl.h,
+ *         base/power/include/clkbuf_v1/mt6771/mtk_clkbuf_hw.h
+ * ------------------------------------------------------------------------ */
+enum clk_buf_id {
+	CLK_BUF_BB_MD		= 0,
+	CLK_BUF_CONN,
+	CLK_BUF_NFC,
+	CLK_BUF_RF,
+	CLK_BUF_AUDIO,
+	CLK_BUF_CHG,
+	CLK_BUF_UFS,
+	CLK_BUF_INVALID
+};
+
+bool clk_buf_ctrl(enum clk_buf_id id, bool onoff);
+bool is_clk_buf_from_pmic(void);
+
+/* ------------------------------------------------------------------------
+ * EMI MPU (memory protection for the region shared with the consys MCU)
+ * vendor: drivers/misc/mediatek/emi/mt6771/mt_emi_api.h,
+ *         drivers/misc/mediatek/emi/submodule/mpu_v1.h
+ * ------------------------------------------------------------------------ */
+#define EMI_MPU_DOMAIN_NUM	16
+#define EMI_MPU_REGION_NUM	32
+#define EMI_MPU_ALIGN_BITS	16
+
+#define NO_PROTECTION	0
+#define SEC_RW		1
+#define SEC_RW_NSEC_R	2
+#define SEC_RW_NSEC_W	3
+#define SEC_R_NSEC_R	4
+#define FORBIDDEN	5
+#define SEC_R_NSEC_RW	6
+
+#define UNLOCK		0
+#define LOCK		1
+
+#define EMI_MPU_DGROUP_NUM	(EMI_MPU_DOMAIN_NUM / 8)
+#define SET_ACCESS_PERMISSION(apc_ary, lock, \
+	d15, d14, d13, d12, d11, d10, d9, d8, d7, d6, d5, d4, d3, d2, d1, d0) \
+do { \
+	apc_ary[1] = \
