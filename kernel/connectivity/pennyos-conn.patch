diff --git a/connectivity/wlan/core/gen3/Kbuild b/connectivity/wlan/core/gen3/Kbuild
new file mode 100644
index 0000000..06a8472
--- /dev/null
+++ b/connectivity/wlan/core/gen3/Kbuild
@@ -0,0 +1,220 @@
+# SPDX-License-Identifier: GPL-2.0
+# pennyos replacement for connectivity/wlan/core/gen3/Makefile, evaluated for
+#   CONFIG_MTK_COMBO_CHIP="CONSYS_6771" (-> WLAN_CHIP_ID=MT6631),
+#   CONFIG_MTK_PLATFORM="mt6771", CONFIG_MTK_WIFI_MCC_SUPPORT=y,
+#   CONFIG_MTK_AEE_FEATURE=y, CONFIG_MTK_PASSPOINT_R2_SUPPORT unset,
+#   CONFIG_MTK_CONN_LTE_IDC_SUPPORT=y, CONFIG_ARCH_MT6797 unset,
+#   TARGET_BUILD_VARIANT=user (see below),
+#   MTK_PROJECT unset (no <project>/fw_config.c),
+#   CONFIG_WLAN_DRV_BUILD_IN=y in the vendor config, but built as a module here.
+# Object list and -D flags are in the same order as the vendor Makefile.
+
+MTK_PLATFORM := mt6771
+WLAN_CHIP_ID := MT6631
+
+# TARGET_BUILD_VARIANT is an Android build variable, not a kernel option.  The
+# phone's vendor firmware is a "user" build (ro.build.type=user), so that is
+# the default here: ASSERT() compiled out (BUILD_QA_DBG=0) and no
+# ENABLED_IN_ENGUSERDEBUG (no wifi.cfg override file).  Any other value, e.g.
+#   TARGET_BUILD_VARIANT=userdebug bash build.sh
+# gives the vendor's debug variant, in which a failed ASSERT() is
+# WARN_ON(1) + panic("Oops") (kalBreakPoint) and wifi.cfg is read.
+# (connectivity/common/Kbuild is hard-wired to the non-user variant.)
+TARGET_BUILD_VARIANT ?= user
+
+# ---------------------------------------------------------------------------
+# pennyos: kernel options the driver is written against.
+#
+# The vendor kernel has CONFIG_ANDROID=y; the driver tests it with "#if" to
+# select its wake lock code.  CONFIG_WAKELOCK is deliberately NOT defined so
+# the driver's own wakeup_source branch is used (linux/wakelock.h is gone).
+ccflags-y += -DCONFIG_ANDROID=1
+# CONFIG_MTK_QOS_SUPPORT=y in the vendor config (os/linux/plat/mt6771/plat_priv.c)
+ccflags-y += -DCONFIG_MTK_QOS_SUPPORT=1
+#
+# cfg80211 / wireless extensions.  The driver needs CONFIG_CFG80211,
+# CONFIG_NL80211_TESTMODE, CONFIG_WIRELESS_EXT (+ WEXT_CORE) and
+# CONFIG_WEXT_PRIV.  If the kernel in $(KDIR) has no cfg80211 at all, build in
+# "compile-check mode": pass those options as -D so the whole driver is still
+# compiled against the 6.4 headers (build.sh then expects the cfg80211 exports
+# to be undefined and says that the module must not be loaded).  With a
+# cfg80211-enabled kernel nothing is assumed; a missing option fails the build.
+ifndef CONFIG_CFG80211
+ccflags-y += -DCONFIG_CFG80211=1
+ccflags-y += -DCONFIG_NL80211_TESTMODE=1
+ccflags-y += -DCONFIG_WIRELESS_EXT=1
+ccflags-y += -DCONFIG_WEXT_CORE=1
+ccflags-y += -DCONFIG_WEXT_PRIV=1
+endif
+# ---------------------------------------------------------------------------
+
+DRIVER_BUILD_DATE=$(shell date +%Y%m%d%H%M%S)
+ccflags-y += -DDRIVER_BUILD_DATE='"$(DRIVER_BUILD_DATE)"'
+
+ccflags-y += -DLINUX -D$(WLAN_CHIP_ID)
+
+ccflags-y += -DCFG_SUPPORT_DEBUG_FS=0
+ccflags-y += -DWLAN_INCLUDE_PROC
