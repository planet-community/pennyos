+EXPORT_SYMBOL(mtk_conn_md_bridge_unreg);
+
+/* TODO(pennyos): real implementation */
+int mtk_conn_md_bridge_send_msg(struct ipc_ilm *ilm)
+{
+	if (ilm)
+		SHIM_STUB_CALLED("src_mod_id=0x%x, dest_mod_id=0x%x, sap_id=0x%x, msg_id=0x%x, local_para_ptr=%p",
+				 ilm->src_mod_id, ilm->dest_mod_id, ilm->sap_id,
+				 ilm->msg_id, ilm->local_para_ptr);
+	else
+		SHIM_STUB_CALLED("ilm=NULL");
+	return CONN_MD_ERR_NO_ERR;
+}
+EXPORT_SYMBOL(mtk_conn_md_bridge_send_msg);
+
+/* ------------------------------------------------------------------------
+ * SPM / sleep
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+unsigned int slp_get_wake_reason(void)
+{
+	SHIM_STUB_CALLED("");
+	return 0;	/* WR_NONE */
+}
+EXPORT_SYMBOL(slp_get_wake_reason);
+
+/* TODO(pennyos): real implementation */
+u32 spm_get_last_wakeup_src(void)
+{
+	SHIM_STUB_CALLED("");
+	return 0;	/* no wakeup source bits */
+}
+EXPORT_SYMBOL(spm_get_last_wakeup_src);
+
+/* ------------------------------------------------------------------------
+ * GIC / GPIO debug dumps
+ * ------------------------------------------------------------------------ */
+
+/* TODO(pennyos): real implementation */
+void mt_irq_dump_status(int irq)
+{
+	SHIM_STUB_CALLED("irq=%d", irq);
+}
+EXPORT_SYMBOL(mt_irq_dump_status);
+
