diff --git a/build.sh b/build.sh
new file mode 100644
index 0000000..96f1710
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,207 @@
+#!/bin/bash
+# pennyos: build the MediaTek connectivity modules out of tree against a
+# configured + built kernel tree.
+#
+#   compat/pennyos_shim.ko                     stubs for vendor-kernel-only services
+#   btif/common/btif.ko                          BTIF driver
+#   connectivity/common/wmt_drv.ko               WMT/STP control layer (+ vendor "connadp" glue)
+#   connectivity/bt/mt66xx/bt_drv.ko             Bluetooth char driver (/dev/stpbt)
+#   connectivity/wlan/adaptor/wmt_chrdev_wifi.ko Wi-Fi power/mode char driver (/dev/wmtWifi)
+#   connectivity/wlan/core/gen3/wlan_drv_gen3.ko Wi-Fi driver (cfg80211)
+#
+# Usage (inside the cosmo-kbuild container):
+#   bash /c/conn/build.sh
+# Environment:
+#   KDIR=/src          kernel build tree (must contain .config and Module.symvers)
+#   CROSS_COMPILE=aarch64-linux-gnu-
+#   JOBS=$(nproc)
+#   NOCLEAN=1          skip the initial "make clean" (incremental build)
+#   KEEP_GOING=1       pass -k to make (collect all errors)
+#
+# Always builds from clean unless NOCLEAN=1.  Exits non-zero on any failure:
+# any compiler error, any modpost error, any undefined symbol in the four
+# control-layer modules, and any undefined symbol in the two Wi-Fi modules
+# that is not explained by cfg80211 being disabled in the kernel (see below).
+#
+# Wi-Fi modules and cfg80211
+# --------------------------
+# The Wi-Fi driver needs these kernel options (WIFI_KCONFIG below).  If the
+# kernel in $KDIR has CONFIG_CFG80211 disabled, the Wi-Fi modules are built in
+# "compile-check mode": the Kbuild files pass the missing options as -D so the
+# code is compiled whole, and the modules end up with undefined references to
+# the cfg80211 / wireless-extensions exports.  That is reported (with the
+# list) and is not a failure, but such a wlan_drv_gen3.ko MUST NOT be loaded:
+# besides the missing symbols, struct net_device / struct cfg80211_ops have a
+# different layout than the running kernel's.  Any other undefined symbol is a
+# failure.
+# If the kernel has CONFIG_CFG80211, nothing is assumed: every option in
+# WIFI_KCONFIG must be set and no undefined symbol is tolerated.
+set -euo pipefail
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+KDIR=${KDIR:-/src}
+CROSS_COMPILE=${CROSS_COMPILE:-aarch64-linux-gnu-}
+JOBS=${JOBS:-$(nproc)}
+LOG="$HERE/build.log"
+MAKE_ARGS=(-C "$KDIR" M="$HERE" ARCH=arm64 CROSS_COMPILE="$CROSS_COMPILE")
+
+MODULES=(
+	compat/pennyos_shim.ko
+	btif/common/btif.ko
+	connectivity/common/wmt_drv.ko
+	connectivity/bt/mt66xx/bt_drv.ko
+)
+WIFI_MODULES=(
+	connectivity/wlan/adaptor/wmt_chrdev_wifi.ko
+	connectivity/wlan/core/gen3/wlan_drv_gen3.ko
+)
+# kernel options the Wi-Fi driver is written against
+WIFI_KCONFIG=(CFG80211 NL80211_TESTMODE WIRELESS_EXT WEXT_CORE WEXT_PRIV)
+
+if [ ! -f "$KDIR/Module.symvers" ] || [ ! -f "$KDIR/.config" ]; then
+	echo "build.sh: $KDIR is not a configured and built kernel tree" >&2
+	exit 1
+fi
+
+kconfig_set() {	# <OPTION without CONFIG_>
+	grep -q -E "^CONFIG_$1=[ym]" "$KDIR/.config"
+}
+
+wifi_missing=()
+for o in "${WIFI_KCONFIG[@]}"; do
+	kconfig_set "$o" || wifi_missing+=("CONFIG_$o")
+done
+if kconfig_set CFG80211; then
+	wifi_mode=real
+	if [ ${#wifi_missing[@]} -ne 0 ]; then
+		echo "build.sh: the kernel has CONFIG_CFG80211 but lacks: ${wifi_missing[*]}" >&2
+		echo "          (required by wlan_drv_gen3; they change struct layouts, so they cannot be assumed)" >&2
+		echo "BUILD FAILED (kernel configuration)"
+		exit 1
+	fi
+else
+	wifi_mode=compile-check
+fi
+
+if [ "${NOCLEAN:-0}" != 1 ]; then
+	make "${MAKE_ARGS[@]}" clean >/dev/null
+fi
+
+# KBUILD_MODPOST_WARN: let modpost finish and link the modules even with
+# unresolved symbols; they are checked (strictly) below instead.
+set +e
+make "${MAKE_ARGS[@]}" -j"$JOBS" ${KEEP_GOING:+-k} KBUILD_MODPOST_WARN=1 modules >"$LOG" 2>&1
+rc=$?
+set -e
+
+nerr=$(grep -c -E '(error:|ERROR:)' "$LOG" || true)
+nwarn=$(grep -c 'warning:' "$LOG" || true)
+
+echo "kernel:   $(make -s -C "$KDIR" ARCH=arm64 kernelrelease 2>/dev/null || echo '?')  ($KDIR)"
+echo "compiler: $("${CROSS_COMPILE}gcc" --version | head -1)"
+echo "errors: $nerr   warnings: $nwarn   (log: $LOG)"
+
+if [ $rc -ne 0 ] || [ "$nerr" -ne 0 ]; then
+	grep -E '(error:|ERROR:|\*\*\*)' "$LOG" | head -"${ERRLINES:-60}" || true
+	echo "BUILD FAILED (make exit $rc)"
+	exit 1
+fi
+
+modinfo_field() {	# <file.ko> <field>
+	"${CROSS_COMPILE}objcopy" -O binary --only-section=.modinfo "$1" /dev/stdout |
+		tr '\0' '\n' | sed -n "s/^$2=//p" | paste -sd, -
+}
+
+fail=0
+printf '\n%-46s %10s  %-18s %s\n' MODULE SIZE VERMAGIC DEPENDS
+for m in "${MODULES[@]}" "${WIFI_MODULES[@]}"; do
+	f="$HERE/$m"
+	if [ ! -s "$f" ]; then
+		printf '%-46s %10s\n' "$m" MISSING
+		fail=1
+		continue
+	fi
+	vm=$(modinfo_field "$f" vermagic)
+	printf '%-46s %10d  %-18s %s\n' "$m" "$(stat -c %s "$f")" "${vm%% *}" \
+		"$(modinfo_field "$f" depends)"
+done
+[ $fail -eq 0 ] || { echo "BUILD FAILED (module file missing)"; exit 1; }
+
+# ---------------------------------------------------------------------------
+# Undefined symbols: everything a module imports must be exported by the
+# kernel ($KDIR/Module.symvers) or by one of our modules ($HERE/Module.symvers).
+# ---------------------------------------------------------------------------
+TMP="$HERE/.build-tmp"
+mkdir -p "$TMP"
+awk -F'\t' '{print $2}' "$KDIR/Module.symvers" "$HERE/Module.symvers" | sort -u >"$TMP/exported"
+
+# Symbols that cfg80211 / wireless extensions / rfkill export in this kernel
+# version, taken from the kernel sources when they are available.
+: >"$TMP/wireless"
+if [ -d "$KDIR/net/wireless" ]; then
+	cat "$KDIR"/net/wireless/*.c "$KDIR"/net/rfkill/*.c 2>/dev/null |
+		sed -n 's/^EXPORT_SYMBOL\(_GPL\)\?(\([A-Za-z0-9_]*\)).*/\2/p' | sort -u >"$TMP/wireless"
+fi
+is_wireless_sym() {	# <symbol>
+	if [ -s "$TMP/wireless" ]; then
+		grep -q -x -F "$1" "$TMP/wireless"
+	else
+		[[ "$1" =~ ^(__)?(cfg80211|wiphy|ieee80211|nl80211|regulatory|wireless|iw_handler|rfkill)_ ]]
+	fi
+}
+
+undefined_of() {	# <file.ko>
+	"${CROSS_COMPILE}nm" -u "$1" | awk '{print $NF}' | sort -u | comm -23 - "$TMP/exported"
+}
+
+echo
+for m in "${MODULES[@]}"; do
+	u=$(undefined_of "$HERE/$m")
+	if [ -n "$u" ]; then
+		echo "$m: UNDEFINED symbols:"
+		echo "$u" | sed 's/^/    /'
+		fail=1
+	fi
+done
+[ $fail -eq 0 ] && echo "control-layer modules: 0 undefined symbols"
+
+wifi_expected=0
+for m in "${WIFI_MODULES[@]}"; do
+	u=$(undefined_of "$HERE/$m")
+	[ -n "$u" ] || continue
+	bad=""
+	good=""
+	for s in $u; do
+		if [ "$wifi_mode" = compile-check ] && is_wireless_sym "$s"; then
+			good+="$s"$'\n'
+		else
+			bad+="$s"$'\n'
+		fi
+	done
+	if [ -n "$good" ]; then
+		wifi_expected=1
+		echo "$m: $(printf '%s' "$good" | wc -l) undefined cfg80211/wireless symbols (expected: kernel has no CONFIG_CFG80211):"
+		printf '%s' "$good" | sed 's/^/    /'
+	fi
+	if [ -n "$bad" ]; then
+		echo "$m: UNDEFINED symbols:"
+		printf '%s' "$bad" | sed 's/^/    /'
+		fail=1
+	fi
+done
+[ $fail -eq 0 ] || { echo "BUILD FAILED (undefined symbols)"; exit 1; }
+
+if [ "$wifi_mode" = compile-check ]; then
+	echo
+	echo "Wi-Fi modules: COMPILE-CHECK ONLY.  The kernel in $KDIR lacks: ${wifi_missing[*]}"
+	echo "  Do not load wlan_drv_gen3.ko from this build; enable the options above,"
+	echo "  rebuild the kernel, then rerun this script."
+	[ $wifi_expected -eq 1 ] || echo "  (no undefined wireless symbols were found, which is unexpected)"
+else
+	echo "Wi-Fi modules: 0 undefined symbols"
+fi
+
+echo
+echo "load order: pennyos_shim -> btif -> wmt_drv -> bt_drv"
+echo "            (cfg80211 ->) wmt_chrdev_wifi -> wlan_drv_gen3"
+echo "BUILD OK"
